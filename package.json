{
  "name": "@figranium/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript and JavaScript SDK for the Figranium API",
  "keywords": ["figranium", "browser-automation", "web-scraping", "sdk"],
  "license": "Apache-2.0",
  "author": "Figranium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figranium/figranium-js.git"
  },
  "homepage": "https://github.com/figranium/figranium-js#readme",
  "bugs": {
    "url": "https://github.com/figranium/figranium-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "docs", "examples", "README.md", "LICENSE", "CHANGELOG.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": { "node": ">=18" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
